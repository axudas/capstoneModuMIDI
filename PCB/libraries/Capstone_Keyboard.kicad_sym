  (symbol "Hall_DRV5055_SOT-23" (pin_names (offset 1.016)) (in_bom yes) (on_board yes)
    (property "Reference" "U" (at -7.62 5.08 0) (effects (font (size 1.27 1.27)) (justify left bottom)))
    (property "Value" "Hall_DRV5055_SOT-23" (at -7.62 -5.08 0) (effects (font (size 1.27 1.27)) (justify left top)))
