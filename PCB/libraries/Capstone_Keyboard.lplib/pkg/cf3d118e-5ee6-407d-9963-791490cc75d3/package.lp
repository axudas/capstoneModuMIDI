(librepcb_package cf3d118e-5ee6-407d-9963-791490cc75d3
 (name "MX-Style Magnetic Key Switch (PCB Mount)")
 (description "Mechanical footprint for MX-compatible magnetic / hall-effect switches (e.g. Gateron KS-20, Magnetic Jade/White): two 1.75 mm plastic-peg holes at +/-5.08 mm, no electrical pins. Footprint \"Center Post\" adds the 4.0 mm centre hole; \"No Center Post\" leaves the centre free for a sensor. 14 x 14 mm switch body and 19.05 mm key pitch on the documentation layer.\nPlace the hall sensor where YOUR switch datasheet puts the magnet.")
