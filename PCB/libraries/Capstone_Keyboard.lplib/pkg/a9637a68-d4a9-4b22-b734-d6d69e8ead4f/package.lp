(librepcb_package a9637a68-d4a9-4b22-b734-d6d69e8ead4f
 (name "Arduino Uno R3 Shield Headers (Metro RP2350)")
 (description "Arduino Uno R3 shield header pattern for the Adafruit Metro RP2350 (#6267), which uses the Arduino Uno R3 board shape. Place this on a shield PCB that plugs on top of the Metro (top view, USB-C/DC jack on the left).\n\nHeaders: 8-pin power + 6-pin analog (bottom), 8-pin D0-D7 + 10-pin D8..SCL (top). Includes the four 3.2 mm Uno mounting holes and the 68.58 x 53.34 mm board outline on the documentation layer.\nThe 2x3 SPI (ICSP) header is NOT included.")
 (keywords "arduino,uno,r3,shield,metro,rp2350,adafruit,header")
 (author "Capstone (generated with Claude)")
