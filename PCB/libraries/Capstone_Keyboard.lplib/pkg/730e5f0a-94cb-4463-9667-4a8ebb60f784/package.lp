(librepcb_package 730e5f0a-94cb-4463-9667-4a8ebb60f784
 (name "TO-92 Hall Effect Sensor (Through-Hole)")
 (description "Through-hole TO-92 / TO-92S hall effect sensor (SS49E, OH49E, DRV5055 LPG ...). Pins 1-2-3 left to right looking at the branded (flat) face.\nFootprints:\n- \"Lying Flat (under key switch)\": leads bent 90 deg ~1.5 mm below the body, body lying on the PCB with the branded face UP. Origin = centre of the sensor body = where the magnet should be. This is the one to use under a magnetic key switch (a TO-92 only senses field through its flat face).\n- \"Upright Wide 2.54mm\": standing, leads spread to 2.54 mm (easy hand soldering).\n- \"Upright 1.27mm\": standing, straight leads.")
 (keywords "hall effect,hall-effect,hall,sensor,to92,to-92,to92s,ss49e,49e,oh49e,tht,through hole,magnetic")
 (author "Capstone (generated with Claude)")
