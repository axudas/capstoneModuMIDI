(librepcb_component 33ae733d-8b95-4dbd-9adb-90c49304b105
 (name "Adafruit Metro RP2350")
 (description "Adafruit Metro RP2350 dev board (RP2350B, 3.3 V logic) in Arduino Uno R3 form factor.\nAll I/O is 3.3 V - do NOT feed 5 V into any pin. A0-A5 are the only ADC inputs (GPIO41-46).\nD22 = GPIO22 (SPI0 SCK), D23 = GPIO23 (SPI0 MOSI). VIN = higher of DC jack / USB voltage.")
 (keywords "metro,rp2350,adafruit,arduino,uno,raspberry pi,dev board")
