(librepcb_device abddd07f-e1c0-4c21-888a-9b7cc6746931
 (name "Hall Effect Sensor SS49E / 49E (TO-92, Through-Hole)")
 (description "Through-hole linear hall effect sensor: Honeywell SS49E, generic 49E / OH49E (the common hobby packs), or TI DRV5055 in TO-92 (LPG). Pinout 1=VCC, 2=GND, 3=OUT, looking at the branded face.\nUnder a magnetic key switch use the \"Lying Flat\" footprint: bend the leads 90 deg about 1.5 mm below the body and lay it on the PCB branded face UP, centred under the magnet.\nSupply 3.3 V (49E clones: check the datasheet minimum, usually 2.7-3.0 V).")
 (keywords "hall effect,hall-effect,ss49e,49e,oh49e,drv5055,ss495a,hall,to92,tht,through hole,magnetic,keyboard")
