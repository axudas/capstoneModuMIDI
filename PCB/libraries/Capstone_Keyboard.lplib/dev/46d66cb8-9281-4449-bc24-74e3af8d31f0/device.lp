(librepcb_device 46d66cb8-9281-4449-bc24-74e3af8d31f0
 (name "Hall Effect Sensor DRV5055 (SOT-23, SMD)")
 (description "TI DRV5055 ratiometric linear bipolar hall sensor, SOT-23 (DBZ). Pinout 1=VCC, 2=OUT, 3=GND.\nRecommended for Gateron KS-20 style magnetic switches (~10 mT at rest, ~90 mT bottomed out): DRV5055A4 (+/-169 mT range, never saturates) or DRV5055A3 (+/-85 mT, more resolution but may clip at bottom-out). Bipolar, so it works whichever magnet pole faces the PCB.")
 (keywords "hall effect,hall-effect,drv5055,hall,ti,sot23,smd,keyboard,magnetic")
