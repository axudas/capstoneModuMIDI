        (property "ki_keywords" "dc barrel jack pj-102ah mean well gst60a12" (at 0 0 0) (effects (font (size 1.27 1.27)) hide))
        (property "ki_description" "PCB jack that mates with the MEAN WELL GST60A12-P1J 12 V / 5 A adapter (5.5 x 2.1 mm plug, centre positive). PJ-102AH is rated 2.5 A - fine for a keyboard/display load; if you ever need the full 5 A use a higher-current jack. Not needed at all if the adapter plugs straight into the Metro RP2350 DC jack.\nParts: PJ-102AH" (at 0 0 0) (effects (font (size 1.27 1.27)) hide))
        (property "ki_fp_filters" "CUI_PJ-102AH*" (at 0 0 0) (effects (font (size 1.27 1.27)) hide))
