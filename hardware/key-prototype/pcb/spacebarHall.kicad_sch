        (property "ki_description" "Through-hole linear hall effect sensor: Honeywell SS49E, generic 49E / OH49E (the common hobby packs), or TI DRV5055 in TO-92 (LPG). Pinout 1=VCC, 2=GND, 3=OUT, looking at the branded face.\nUnder a magnetic key switch use the \"Lying Flat\" footprint: bend the leads 90 deg about 1.5 mm below the body and lay it on the PCB branded face UP, centred under the magnet.\nSupply 3.3 V (49E clones: check the datasheet minimum, usually 2.7-3.0 V).\nParts: SS49E, DRV5055A4QLPG, DRV5055A3QLPG" (at 0 0 0) (effects (font (size 1.27 1.27)) hide))
        (property "ki_fp_filters" "Hall_TO-92*" (at 0 0 0) (effects (font (size 1.27 1.27)) hide))
