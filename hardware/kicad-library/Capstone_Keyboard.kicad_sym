    (property "Datasheet" "https://www.ti.com/lit/ds/symlink/drv5055.pdf" (at 0 0 0) (effects (font (size 1.27 1.27)) hide))
    (property "ki_keywords" "hall effect hall-effect drv5055 hall ti sot23 smd keyboard magnetic" (at 0 0 0) (effects (font (size 1.27 1.27)) hide))
    (property "ki_description" "TI DRV5055 ratiometric linear bipolar hall sensor, SOT-23 (DBZ). Pinout 1=VCC, 2=OUT, 3=GND.\nRecommended for Gateron KS-20 style magnetic switches (~10 mT at rest, ~90 mT bottomed out): DRV5055A4 (+/-169 mT range, never saturates) or DRV5055A3 (+/-85 mT, more resolution but may clip at bottom-out). Bipolar, so it works whichever magnet pole faces the PCB.\nParts: DRV5055A4QDBZR, DRV5055A3QDBZR, DRV5055A2QDBZR, DRV5055A1QDBZR" (at 0 0 0) (effects (font (size 1.27 1.27)) hide))
    (property "ki_fp_filters" "Hall_SOT-23*" (at 0 0 0) (effects (font (size 1.27 1.27)) hide))
