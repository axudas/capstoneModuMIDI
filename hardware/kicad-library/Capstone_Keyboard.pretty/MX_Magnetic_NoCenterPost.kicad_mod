(footprint "MX_Magnetic_NoCenterPost" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "Mechanical footprint for MX-compatible magnetic / hall-effect switches (e.g. Gateron KS-20, Magnetic Jade/White): two 1.75 mm plastic-peg holes at +/-5.08 mm, no electrical pins. Footprint \"Center Post\" adds the 4.0 mm centre hole; \"No Center Post\" leaves the centre free for a sensor. 14 x 14 mm switch body and 19.05 mm key pitch on the documentation layer.\nPlace the hall sensor where YOUR switch datasheet puts the magnet.\nVariant: No Center Post")
  (tags "mx,cherry,magnetic,hall,gateron,ks-20,keyswitch,keyboard")
  (attr exclude_from_pos_files)
  (fp_text reference "REF**" (at 0 -7.4) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.2)) (justify bottom)))
  (fp_text value "MX_Magnetic_NoCenterPost" (at 0 7.4) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.2)) (justify top)))
  (fp_line (start -7 -7) (end 7 -7) (stroke (width 0.2) (type solid)) (layer "F.Fab"))
  (fp_line (start 7 -7) (end 7 7) (stroke (width 0.2) (type solid)) (layer "F.Fab"))
  (fp_line (start 7 7) (end -7 7) (stroke (width 0.2) (type solid)) (layer "F.Fab"))
  (fp_line (start -7 7) (end -7 -7) (stroke (width 0.2) (type solid)) (layer "F.Fab"))
  (fp_line (start -9.525 -9.525) (end 9.525 -9.525) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start 9.525 -9.525) (end 9.525 9.525) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start 9.525 9.525) (end -9.525 9.525) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start -9.525 9.525) (end -9.525 -9.525) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start -7 -7) (end 7 -7) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start 7 -7) (end 7 7) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start 7 7) (end -7 7) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start -7 7) (end -7 -7) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (pad "" np_thru_hole circle (at -5.08 0) (size 1.75 1.75) (drill 1.75) (layers "*.Cu" "*.Mask"))
