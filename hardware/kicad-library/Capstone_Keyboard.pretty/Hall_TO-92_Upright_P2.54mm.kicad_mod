  (fp_line (start -3.6 -1.3) (end 3.6 -1.3) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start 3.6 -1.3) (end 3.6 1.5) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
