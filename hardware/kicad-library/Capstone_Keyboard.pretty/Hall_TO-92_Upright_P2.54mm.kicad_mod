(footprint "Hall_TO-92_Upright_P2.54mm" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "Through-hole TO-92 / TO-92S hall effect sensor (SS49E, OH49E, DRV5055 LPG ...). Pins 1-2-3 left to right looking at the branded (flat) face.\nFootprints:\n- \"Lying Flat (under key switch)\": leads bent 90 deg ~1.5 mm below the body, body lying on the PCB with the branded face UP. Origin = centre of the sensor body = where the magnet should be. This is the one to use under a magnetic key switch (a TO-92 only senses field through its flat face).\n- \"Upright Wide 2.54mm\": standing, leads spread to 2.54 mm (easy hand soldering).\n- \"Upright 1.27mm\": standing, straight leads.\nVariant: Upright Wide 2.54mm")
  (tags "hall effect,hall-effect,hall,sensor,to92,to-92,to92s,ss49e,49e,oh49e,tht,through hole,magnetic")
  (attr through_hole)
