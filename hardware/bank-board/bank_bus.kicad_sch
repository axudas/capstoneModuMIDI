  (text "Bank address: JP2/JP3 read through RP2350 internal pull-ups (closed = 0). Banks 1-4 = 00, 01, 10, 11.\nSame idea as the solder bridges on the 2023 bank boards."
    (at 76.2 177.8 0)
    (effects
      (font
        (size 1.5 1.5))
      (justify left bottom))
