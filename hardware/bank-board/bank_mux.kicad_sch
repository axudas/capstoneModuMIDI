  (text "Four CD74HC4067 16:1 muxes on +3.3VA, all sharing MUX_S0-S3, enables tied low. Each COM goes to its own ADC pin,\nso one select step samples key n, key n+15, presence n and presence n+15. Channel 15: V12_SENSE / V5_SENSE on the\nkey muxes (rail monitors), GND on the presence muxes (a zero reference the firmware can check)."
    (at 25.4 190.5 0)
    (effects
      (font
        (size 1.5 1.5))
      (justify left bottom))
    (uuid "9200e52a-9c0c-5cf1-8c87-71b164c09023")))
